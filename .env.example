# Чтобы включить живые вопросы AI, вставьте свой ключ сюда.
# Ключ остаётся на FastAPI-сервере и не попадает во Flutter.
AI_PROVIDER=openai
AI_API_KEY=
AI_MODEL=gpt-6-astra

# Оставьте пустыми для локального SQLite.
# Чтобы включить Supabase, заполните URL и SERVICE_ROLE_KEY,
# затем выполните backend/supabase/schema.sql в SQL Editor проекта.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# По умолчанию вымышленные примеры не добавляются: каталог пуст,
# пока люди сами не создадут задачи и не отправят отклики.
# Для показа примеров на отдельной чистой базе задайте true.
DEMO_SEED=false

# Почта владельца: войдите или зарегистрируйте именно этот адрес, чтобы получить личный кабинет.
ADMIN_EMAIL=

# Секрет для подписи сессий. Задайте длинное случайное значение;
# на хостинге сохраните это значение в секретах окружения сервера.
AUTH_SECRET=

# Почтовый сервер для ссылок подтверждения. Если пусто, ссылка печатается
# в терминал только для локальной разработки; на сайте настройте SMTP.
APP_PUBLIC_URL=http://127.0.0.1:8000
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Для NVIDIA NIM: AI_PROVIDER=nvidia и задайте model slug из вашего каталога NIM.
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# AI_MODEL=meta/llama-3.3-70b-instruct
